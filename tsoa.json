{
  "entryFile": "run-server.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/**/*.route.ts"],
  "spec": {
    "outputDirectory": "build",
    "specVersion": 3,
    "basePath": "/api"
  },
  "routes": {
    "routesDir": "build",
    "middleware": "koa"
  }
}
